# Optional. Without both values, `npm run discover` uses the scripted dummy
# provider and does not call Gemini. A live run also needs the --live flag.
# .env is ignored by Git. Do not put a real key in this example.
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional. Enables the evaluator-only routes of `npm run serve`. Without it
# those routes are disabled. Use a long random value.
XENO_OPERATOR_TOKEN=

# Optional. Keeps `npm run serve` sessions in MongoDB so they survive restarts.
# Without it sessions live in memory. The URI may contain a password; it is
# never printed. XENO_MONGODB_DB defaults to "xeno".
XENO_MONGODB_URI=
XENO_MONGODB_DB=
