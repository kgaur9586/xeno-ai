{
  "name": "xeno-ai",
  "version": "0.1.0",
  "private": true,
  "description": "XENO: an experimental system that discovers hidden rules in simulated worlds.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json",
    "build": "tsc -p tsconfig.build.json",
    "baselines": "npm run build && node dist/cli/baselines.js",
    "discover": "npm run build && node dist/cli/discover.js",
    "compare": "npm run build && node dist/cli/compare.js",
    "transfer": "npm run build && node dist/cli/transfer.js",
    "build:web": "vite build --config web/vite.config.ts",
    "serve": "npm run build && npm run build:web && node dist/cli/serve.js",
    "dashboard:dev": "vite --config web/vite.config.ts"
  },
  "dependencies": {
    "@google/genai": "^2.29.1",
    "mongodb": "^7.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  }
}
